# Copy to .env locally; never commit .env or real values.
QWEN_MODEL_NAME=Qwen3.5-4B
QWEN_CONTEXT_SIZE=32768
QWEN_MAX_CONCURRENT=4
QWEN_BACKENDS=http://127.0.0.1:8081,http://127.0.0.1:8082
QWEN_FAST_BACKEND=http://127.0.0.1:8083
QWEN_IMAGE_BACKEND=http://127.0.0.1:8090
ROMAN_SEARCH_BASE_URL=https://search.romanlms.com
WEB_SEARCH_RESULTS=5
AGENT_MAX_RUNTIME_SECONDS=900
QWEN_TURN_TIMEOUT_SECONDS=180
PUBLIC_HOSTNAME=

# Inject these through a secret manager in real deployments.
QWEN_API_KEY=replace-with-a-rotated-key
ROMAN_SEARCH_API_KEY=replace-with-a-rotated-key
CLOUDFLARE_TUNNEL_TOKEN=replace-with-a-rotated-token
